{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string", "format": "uri" },
        "favorites": { "type": "array", "items": { "type": "string" } },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "minecraftEdition": { "type": "string", "enum": ["java", "bedrock"] },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "points": { "type": "number" },
        "purchased": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email"]
    },
    "Game": {
      "title": "Game",
      "description": "Information about a game available for download",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnail": { "type": "string", "format": "uri" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "price": { "type": "string" },
        "pointsPrice": { "type": "number" }
      },
      "required": ["title", "downloadUrl"]
    },
    "Report": {
      "title": "Report",
      "description": "User feedback or problem report",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string", "format": "email" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "resolved"] }
      },
      "required": ["message", "timestamp"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Social links configurations",
      "type": "object",
      "properties": {
        "tiktok": { "type": "string" },
        "telegram": { "type": "string" },
        "discord": { "type": "string" },
        "youtube": { "type": "string" },
        "twitter": { "type": "string" }
      }
    },
    "Ad": {
      "title": "Ad",
      "description": "Interactive advertisements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "imageUrl": { "type": "string" },
        "link": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["imageUrl", "link"]
    },
    "Review": {
      "title": "Review",
      "description": "User reviews and ratings for mods",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["gameId", "userId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/games/{gameId}": {
      "schema": "Game",
      "description": "List of available games"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User feedback and reports"
    },
    "/settings/{docId}": {
      "schema": "SiteSettings",
      "description": "Site global features"
    },
    "/ads/{adId}": {
      "schema": "Ad",
      "description": "Interactive advertising campaigns"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Mod reviews and comments"
    }
  }
}
